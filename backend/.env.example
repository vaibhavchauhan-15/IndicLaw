# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=llama3
FALLBACK_MODEL=mistral
BACKUP_MODEL=gemma:7b

# API Timeout (in milliseconds)
API_TIMEOUT_MS=45000

# Upload settings
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,jpg,png

# Reference information (for UI)
SITE_TITLE=IndicLaw AI
REFERER_URL=http://localhost:3000

# Legacy OpenAI/OpenRouter config (can be removed if not needed)
# OPENROUTER_API_KEY=your_api_key_here
